# Salin file ini jadi ".env" lalu isi nilai sebenarnya. Jangan commit ".env".

# Port backend HTTP (API + web dashboard statis)
PORT=3000

# API key yang HARUS dikirim perangkat ESP32 di header x-api-key
# saat POST /api/ingest. Samakan dengan DEVICE_API_KEY di firmware.
DEVICE_API_KEY=ganti-dengan-api-key-perangkat

# API key terpisah untuk endpoint admin (PUT /api/config/thresholds).
ADMIN_API_KEY=ganti-dengan-api-key-admin

# Token bot Telegram dari BotFather (@BotFather -> /newbot).
TELEGRAM_BOT_TOKEN=ganti-dengan-token-bot-telegram

# Berapa menit tanpa data baru sebelum perangkat dianggap offline.
DEVICE_OFFLINE_MINUTES=5

# Lokasi file database SQLite (dibuat otomatis kalau belum ada).
DB_FILE=./data/ecosense.sqlite
